# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Platformio
.pio
.pioenvs
.piolibdeps

launch.json
c_cpp_properties.json
.history

# Claude Code per-machine settings
.claude/settings.local.json

# Python bytecode from the tools
__pycache__/
*.pyc

# Generated from songs/songs.json at build time
src/songs_data.cpp
# MIDI files are usually someone else's copyright - keep them local
songs/*.mid
